# Configuration HisabPro Backend
# Copie ce fichier en .env et adapte les valeurs

DATABASE_URL=postgresql://hisabpro:MOT_DE_PASSE@localhost:5432/hisabpro
# Générer une valeur longue et aléatoire, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer-par-une-cle-aleatoire
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS - origines autorisées (frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Coffre RH :chemin ABSOLU d'un trousseau privé hors dépôt/base/archives métier.
# Vide = collecte désactivée. Aucune clé secrète ne doit être écrite ici.
PERSONNEL_COFFRE_CLES_FICHIER=
